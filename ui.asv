classdef ui < matlab.apps.AppBase

    % Properties that correspond to app components
    properties (Access = public)
        UIFigure                     matlab.ui.Figure
        WordsEditField               matlab.ui.control.EditField
        WordsEditFieldLabel          matlab.ui.control.Label
        word_1Button_3               matlab.ui.control.Button
        word_1Button_2               matlab.ui.control.Button
        word_1Button                 matlab.ui.control.Button
        PredictionLabel              matlab.ui.control.Label
        PowerfulWordSuggestionLabel  matlab.ui.control.Label
        UIAxes                       matlab.ui.control.UIAxes
    end

    % Component initialization
    methods (Access = private)

        % Create UIFigure and components
        function createComponents(app)

            % Create UIFigure and hide until all components are created
            app.UIFigure = uifigure('Visible', 'off');
            app.UIFigure.Position = [100 100 836 480];
            app.UIFigure.Name = 'MATLAB App';

            % Create PowerfulWordSuggestionLabel
            app.PowerfulWordSuggestionLabel = uilabel(app.UIFigure);
            app.PowerfulWordSuggestionLabel.HorizontalAlignment = 'center';
            app.PowerfulWordSuggestionLabel.FontSize = 36;
            app.PowerfulWordSuggestionLabel.Position = [200 423 439 47];
            app.PowerfulWordSuggestionLabel.Text = 'Powerful Word Suggestion';

            % Create PredictionLabel
            app.PredictionLabel = uilabel(app.UIFigure);
            app.PredictionLabel.FontSize = 36;
            app.PredictionLabel.Position = [34 293 175 47];
            app.PredictionLabel.Text = 'Prediction:';

            % Create word_1Button
            app.word_1Button = uibutton(app.UIFigure, 'push');
            app.word_1Button.HorizontalAlignment = 'left';
            app.word_1Button.VerticalAlignment = 'top';
            app.word_1Button.FontSize = 24;
            app.word_1Button.Position = [40 236 354 39];
            app.word_1Button.Text = 'word_1';

            % Create word_1Button_2
            app.word_1Button_2 = uibutton(app.UIFigure, 'push');
            app.word_1Button_2.HorizontalAlignment = 'left';
            app.word_1Button_2.VerticalAlignment = 'top';
            app.word_1Button_2.FontSize = 24;
            app.word_1Button_2.Position = [38 177 354 39];
            app.word_1Button_2.Text = 'word_1';

            % Create word_1Button_3
            app.word_1Button_3 = uibutton(app.UIFigure, 'push');
            app.word_1Button_3.HorizontalAlignment = 'left';
            app.word_1Button_3.VerticalAlignment = 'top';
            app.word_1Button_3.FontSize = 24;
            app.word_1Button_3.Position = [39 115 354 39];
            app.word_1Button_3.Text = 'word_1';

            % Create WordsEditFieldLabel
            app.WordsEditFieldLabel = uilabel(app.UIFigure);
            app.WordsEditFieldLabel.HorizontalAlignment = 'right';
            app.WordsEditFieldLabel.FontSize = 24;
            app.WordsEditFieldLabel.Position = [34 357 87 32];
            app.WordsEditFieldLabel.Text = 'Words: ';

            % Create WordsEditField
            app.WordsEditField = uieditfield(app.UIFigure, 'text');
            app.WordsEditField.FontSize = 24;
            app.WordsEditField.Position = [136 354 150 35];
            app.WordsEditField.ValueChangedFcn = @(src,event) ( ...
                set(app.PredictionLabel,'Text',['Prediction: ' src.Value]); ...
                disp(['User typed: ' src.Value]); ...
                bar(app.UIAxes, randi(10,1,5)) ...
            );


            % Create Axes
            app.UIAxes = uiaxes(app.UIFigure);
            app.UIAxes.Position = [500 100 200 200]; % Adjust position/size
            title(app.UIAxes, 'Word Frequency');
            xlabel(app.UIAxes, 'Words');
            ylabel(app.UIAxes, 'Count');

            % data
            words = {'apple','banana','cherry'};
            counts = [5, 3, 7];
            
            % Plot bar chart
            bar(app.UIAxes, counts);
            set(app.UIAxes, 'XTickLabel', words);


            % Show the figure after all components are created
            app.UIFigure.Visible = 'on';
        end
    end

    % App creation and deletion
    methods (Access = public)

        % Construct app
        function app = ui

            % Create UIFigure and components
            createComponents(app)

            % Register the app with App Designer
            registerApp(app, app.UIFigure)

            if nargout == 0
                clear app
            end
        end

        % Code that executes before app deletion
        function delete(app)

            % Delete UIFigure when app is deleted
            delete(app.UIFigure)
        end
    end
end